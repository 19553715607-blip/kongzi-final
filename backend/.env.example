# 复制为 .env 后按需修改。默认值即可零配置启动（SQLite + Mock LLM）。

# 数据库：默认 SQLite 本地文件；生产换成 Postgres：
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/kongzi
DATABASE_URL=sqlite:///./kongzi.db

# LLM 提供方：mock | openai | anthropic | qwen
# mock：不调用任何外部模型，基于检索证据拼装回答，零成本可跑通全链路
LLM_PROVIDER=mock

# 当 LLM_PROVIDER=openai 时填入
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# 当 LLM_PROVIDER=anthropic 时填入
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest

# 当 LLM_PROVIDER=qwen 时填入（阿里通义千问 / DashScope 兼容模式）
# 可选模型：qwen-plus（平衡）/ qwen-max（最强）/ qwen-turbo（最快） /
#           qwen-long（长文本）/ qwen2.5-72b-instruct
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus

# 知识图谱后端：memory(零配置内存图) | neo4j
GRAPH_BACKEND=memory
# 切 neo4j 时填写（见 docker-compose.neo4j.yml）
NEO4J_URI=
NEO4J_USER=neo4j
NEO4J_PASSWORD=kongzi-graph

# CORS 允许的前端地址
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# 管理员邮箱白名单（逗号分隔，登录后自动置 is_admin=True）
ADMIN_EMAILS=
